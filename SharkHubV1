local function findLocationPart(targetName)
    local miscFolder = Workspace:FindFirstChild("Misc")
    if miscFolder then
        local rakoofSpawns = miscFolder:FindFirstChild("RakoofSpawns")
        if rakoofSpawns and rakoofSpawns:FindFirstChild(targetName) then
            return rakoofSpawns:FindFirstChild(targetName)
        end
    end

    local locFolder = Workspace:FindFirstChild("LocationsIndicator")
    if locFolder then
        local targetAltName = (targetName == "CaveA") and "Cave1" or (targetName == "CaveB") and "Cave2" or targetName
        if locFolder:FindFirstChild(targetAltName) then return locFolder:FindFirstChild(targetAltName) end
        if locFolder:FindFirstChild(targetName) then return locFolder:FindFirstChild(targetName) end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == targetName then return obj end
    end
    return nil
end

local function teleportToLocation(targetName)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local targetObj = findLocationPart(targetName)
    if targetObj then
        local targetPart = targetObj:IsA("BasePart") and targetObj or (targetObj:IsA("Model") and (targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart")))
        if targetPart then
            character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        end
    end
end

CaveABtn.MouseButton1Click:Connect(function() teleportToLocation("CaveA") end)
CaveBBtn.MouseButton1Click:Connect(function() teleportToLocation("CaveB") end)

