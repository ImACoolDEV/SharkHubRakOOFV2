setupMinimizeControl(TournamentFrame, CloseTournament)

SharkCircleBtn.MouseButton1Click:Connect(function()
    for _, frame in ipairs(activeMinimizedFrames) do
        frame.Visible = true
    end
    table.clear(activeMinimizedFrames)
    SharkCircleBtn.Visible = false
end)

