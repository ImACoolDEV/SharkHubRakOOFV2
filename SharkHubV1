--------------------------------------------------------------------------------
-- OPTIMIZED REMOTE CACHING SYSTEM
--------------------------------------------------------------------------------
local cachedRemotes = {
    GiftRain = {},
    LootItem = {},
    ItemDrop = {},
    Spin = {}
}

local function updateRemoteCache()
    table.clear(cachedRemotes.GiftRain)
    table.clear(cachedRemotes.LootItem)
    table.clear(cachedRemotes.ItemDrop)
    table.clear(cachedRemotes.Spin)

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("BindableEvent") then
            local nameLower = string.lower(obj.Name)
            if nameLower == "giftrain" or string.find(nameLower, "giftrain") then
                table.insert(cachedRemotes.GiftRain, obj)
            elseif (nameLower == "lootitem" or string.find(nameLower, "lootitem")) and not string.find(nameLower, "player") then
                table.insert(cachedRemotes.LootItem, obj)
            elseif string.find(nameLower, "itemdrop") or string.find(nameLower, "drop") then
                table.insert(cachedRemotes.ItemDrop, obj)
            elseif string.find(nameLower, "spin") or string.find(nameLower, "crate") or string.find(nameLower, "wheel") or string.find(nameLower, "roll") then
                table.insert(cachedRemotes.Spin, obj)
            end
        end
    end
end

updateRemoteCache()

local function triggerGiftRainAndLoot(multiplier)
    if #cachedRemotes.GiftRain == 0 and #cachedRemotes.LootItem == 0 then
        updateRemoteCache()
    end
    for _, obj in ipairs(cachedRemotes.GiftRain) do
        pcall(function()
            if obj:IsA("BindableEvent") then obj:Fire(multiplier) else obj:FireServer(multiplier) end
        end)
    end
    for _, obj in ipairs(cachedRemotes.LootItem) do
        pcall(function()
            if obj:IsA("BindableEvent") then obj:Fire(multiplier) else obj:FireServer(multiplier) end
        end)
    end
end

local function findTargetModel(query)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), string.lower(query)) then
            local targetPart = obj:FindFirstChild("Torso")
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("LowerTorso")
                or obj.PrimaryPart
                or obj:FindFirstChildWhichIsA("BasePart")
            if targetPart then return obj, targetPart end
        end
    end
    return nil, nil
end

local function executeSpamClick()
    VirtualUser:Button1Down(Vector2.zero, Workspace.CurrentCamera.CFrame)
    VirtualUser:Button1Up(Vector2.zero, Workspace.CurrentCamera.CFrame)
    local character = LocalPlayer.Character
    if character then
        local equippedTool = character:FindFirstChildOfClass("Tool")
        if equippedTool then equippedTool:Activate() end
    end
end

local function triggerCalamityInsideRake()
    local rakeModel = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), "the_rake") then
            rakeModel = obj
            break
        end
    end
    if not rakeModel then return 0 end

    local triggeredCount = 0
    for _, target in ipairs(rakeModel:GetDescendants()) do
        if target.Name == "MainCalamity" or target.Name == "CalamityMAIN" then
            triggeredCount = triggeredCount + 1
            if target:IsA("RemoteEvent") or target:IsA("UnreliableRemoteEvent") then
                pcall(function() target:FireServer() end)
            elseif target:IsA("BindableEvent") then
                pcall(function() target:Fire() end)
            elseif target:IsA("ModuleScript") then
                pcall(function() 
                    local loadedModule = require(target)
                    if type(loadedModule) == "function" then loadedModule()
                    elseif type(loadedModule) == "table" and loadedModule.Init then loadedModule.Init() end
                end)
            elseif target:IsA("Script") or target:IsA("LocalScript") then
                target.Disabled = false
                target.Enabled = true
            end
        end
    end
    return triggeredCount
end

local function enableContinuousNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local character = LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end

local function disableContinuousNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

