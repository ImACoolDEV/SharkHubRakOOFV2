RenameToolBtn.MouseButton1Click:Connect(function()
    local oldName = ToolOldBox.Text:lower()
    local newName = ToolNewBox.Text
    if oldName == "" or newName == "" then return end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    local renamedCount = 0

    local function renameItem(tool)
        if tool:IsA("Tool") and string.find(tool.Name:lower(), oldName) then
            tool.Name = newName
            tool.ToolTip = newName
            renamedCount = renamedCount + 1
        end
    end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do renameItem(tool) end
    end
    if character then
        for _, tool in ipairs(character:GetChildren()) do renameItem(tool) end
    end

    if renamedCount > 0 then
        RenameToolBtn.Text = "✅ Renamed (" .. renamedCount .. ")"
    else
        RenameToolBtn.Text = "❌ Not Found!"
    end

    task.delay(2, function()
        RenameToolBtn.Text = "Rename Tool"
    end)
end)

