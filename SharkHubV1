-- Strictly searches inside THE_RAKE model for CalamityMAIN to trigger it
local function triggerCalamityInsideRake()
    local rakeModel = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), "the_rake") then
            rakeModel = obj
            break
        end
    end

    if not rakeModel then
        warn("THE_RAKE model not found in Workspace!")
        return 0
    end

    local triggeredCount = 0

    for _, target in ipairs(rakeModel:GetDescendants()) do
        if target.Name == "CalamityMAIN" then
            triggeredCount = triggeredCount + 1
            
            if target:IsA("RemoteEvent") or target:IsA("UnreliableRemoteEvent") then
                pcall(function() target:FireServer() end)
            elseif target:IsA("BindableEvent") then
                pcall(function() target:Fire() end)
            elseif target:IsA("ModuleScript") then
                pcall(function() 
                    local loadedModule = require(target)
                    if type(loadedModule) == "function" then
                        loadedModule()
                    elseif type(loadedModule) == "table" and loadedModule.Init then
                        loadedModule.Init()
                    end
                end)
            elseif target:IsA("Script") or target:IsA("LocalScript") then
                target.Disabled = false
                target.Enabled = true
            end
        end
    end

    return triggeredCount
end

local function enableContinuousNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local character = LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end

local function disableContinuousNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

