local function findItemDropRemote()
    local itemDrop = ReplicatedStorage:FindFirstChild("ItemDrop", true) or Workspace:FindFirstChild("ItemDrop", true)
    if itemDrop and (itemDrop:IsA("RemoteEvent") or itemDrop:IsA("UnreliableRemoteEvent")) then
        return itemDrop
    end

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "itemdrop") or string.find(nameLower, "drop") or string.find(nameLower, "loot") or string.find(nameLower, "luck") then
                return obj
            end
        end
    end
    return nil
end

local function applyLuckMultiplier(multiplier)
    local remote = findItemDropRemote()
    if remote then
        pcall(function()
            remote:FireServer("SetLuck", multiplier)
            remote:FireServer({Luck = multiplier, Boost = true})
        end)
    end
end

local function findTargetModel(query)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), string.lower(query)) then
            local targetPart = obj:FindFirstChild("Torso")
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("LowerTorso")
                or obj.PrimaryPart
                or obj:FindFirstChildWhichIsA("BasePart")

            if targetPart then return obj, targetPart end
        end
    end
    return nil, nil
end

local function getBestWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return nil end

    for _, weaponName in ipairs(WEAPON_PRIORITY) do
        local equipped = character:FindFirstChild(weaponName)
        if equipped and equipped:IsA("Tool") then return equipped end
        
        local inBackpack = backpack:FindFirstChild(weaponName)
        if inBackpack and inBackpack:IsA("Tool") then return inBackpack end
    end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end
    return nil
end

local function executeFarmAttack()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local bestTool = getBestWeapon()
    
    if humanoid and bestTool then
        if bestTool.Parent ~= character then humanoid:EquipTool(bestTool) end
        bestTool:Activate()
        VirtualUser:Button1Down(Vector2.zero, Workspace.CurrentCamera.CFrame)
        VirtualUser:Button1Up(Vector2.zero, Workspace.CurrentCamera.CFrame)
    end
end

local function executeHotbarSlot1Attack()
    local character = LocalPlayer.Character
    if not character then return end
    
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
    
    local equippedTool = character:FindFirstChildOfClass("Tool")
    if equippedTool then equippedTool:Activate() end
    
    VirtualUser:Button1Down(Vector2.zero, Workspace.CurrentCamera.CFrame)
    VirtualUser:Button1Up(Vector2.zero, Workspace.CurrentCamera.CFrame)
end

local function enableContinuousNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local character = LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end

local function disableContinuousNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

