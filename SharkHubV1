    dotBtn.Size = UDim2.new(0, 30, 0, 30)
    dotBtn.Position = pos
    dotBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(0, 140, 255)
    dotBtn.Text = tostring(i)
    dotBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    dotBtn.Font = Enum.Font.GothamBold
    dotBtn.TextSize = 14
    dotBtn.ZIndex = 72
    dotBtn.Parent = DotsArea
    Instance.new("UICorner", dotBtn).CornerRadius = UDim.new(1, 0)

    dotBtn.MouseButton1Click:Connect(function()
        if i == currentDotIndex then
            dotBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
            currentDotIndex = currentDotIndex + 1

            if currentDotIndex > #dotPositions then
                connectDotsWins = connectDotsWins + 1
                ConnectDotsTitle.Text = "✨ CONNECT THE DOTS (Wins: " .. tostring(connectDotsWins) .. "/10)"

                if connectDotsWins >= 10 then
                    ConnectDotsFrame.Visible = false
                    TournamentFrame.Visible = true
                else
                    task.wait(0.3)
                    resetConnectDotsGame()
                end
            end
        end
    end)

    table.insert(dotButtons, dotBtn)
end

