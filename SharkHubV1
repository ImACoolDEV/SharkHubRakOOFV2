local function ApplyHoverEffects(btn, stroke)
    btn.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Thickness = 2.5}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Thickness = 1.5}):Play()
    end)
end

local function CreateButton(text, order, initialActive)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.LayoutOrder = order
    btn.ZIndex = 12
    btn.Parent = ScrollingFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)
    
    local grad = Instance.new("UIGradient")
    grad.Color = initialActive and ON_GRADIENT or OFF_GRADIENT
    grad.Rotation = 90
    grad.Parent = btn

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.5
    stroke.Color = initialActive and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(40, 60, 90)

    ApplyHoverEffects(btn, stroke)
    return btn, stroke, grad
end

