local isBattling = false
local function startSharkBattle(userChoice)
    if isBattling then return end
    isBattling = true
    ArenaStatus.Text = "BRAWL STARTED!"

    for i = 1, 10 do
        Fighter1.Position = UDim2.new(0.1 + (i * 0.025), 0, 0.35, 0)
        Fighter2.Position = UDim2.new(0.75 - (i * 0.025), 0, 0.35, 0)
        task.wait(0.1)
    end

    local won = math.random(1, 2) == userChoice
    if won then
        ArenaStatus.Text = "🏆 YOUR SHARK WON THE TOURNAMENT!"
    else
        ArenaStatus.Text = "💥 YOUR SHARK WAS DEFEATED!"
    end

    task.wait(2)
    Fighter1.Position = UDim2.new(0.1, 0, 0.35, 0)
    Fighter2.Position = UDim2.new(0.75, 0, 0.35, 0)
    ArenaStatus.Text = "Select your fighter below!"
    isBattling = false
end

PickGreatWhiteBtn.MouseButton1Click:Connect(function() startSharkBattle(1) end)
PickMegBtn.MouseButton1Click:Connect(function() startSharkBattle(2) end)

