local function safeTeleportBehind(targetRoot)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetRoot then return end

    -- Temporary noclip on character parts to prevent physics engine from launching you into the sky
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local targetCF = targetRoot.CFrame
    local behindPosition = targetCF.Position - (targetCF.LookVector * 3.5)
    
    hrp.CFrame = CFrame.new(behindPosition, targetCF.Position)
end

local function findBossRoot()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, TARGET_NAME) or string.find(nameLower, "ashbound") then
                local targetPart = obj:FindFirstChild("HumanoidRootPart") 
                    or obj:FindFirstChild("Torso") 
                    or obj:FindFirstChild("UpperTorso") 
                    or obj.PrimaryPart
                
                if targetPart then
                    return obj, targetPart
                end
            end
        end
    end
    return nil, nil
end

