local function CreateButton(text, order, initialActive)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = initialActive and Color3.fromRGB(0, 110, 160) or Color3.fromRGB(18, 32, 48)
    btn.BackgroundTransparency = 0.15
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 250, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    btn.LayoutOrder = order
    btn.AutoButtonColor = true
    btn.Active = true
    btn.Parent = ScrollingFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Color = initialActive and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(30, 60, 90)
    stroke.Transparency = 0.3
    stroke.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.0}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.15}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
    end)
    
    return btn, stroke
end

