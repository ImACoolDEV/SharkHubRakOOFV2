-- 5. SAFEZONE TELEPORT LOGIC
--------------------------------------------------------------------------------
local function findSafezoneNPC()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "ready") or string.find(nameLower, "safe") or string.find(nameLower, "spawn") or string.find(nameLower, "npc") then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                if root then return root end
            end
        end
    end
    return nil
end

SafezoneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local targetNPC = findSafezoneNPC()
    if targetNPC then
        character.HumanoidRootPart.CFrame = targetNPC.CFrame * CFrame.new(0, 0, -3)
    else
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("SpawnLocation") then
                character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3.5, 0)
                break
            end
        end
    end
end)

