-- AI Battle Mode targeting THE_RAKE & trigger CalamityMAIN inside THE_RAKE
AIBattleBtn.MouseButton1Click:Connect(function()
    AI_BATTLE_ENABLED = not AI_BATTLE_ENABLED
    AIBattleBtn.Text = AI_BATTLE_ENABLED and "🤖 AI BATTLE (THE_RAKE): ON" or "🤖 AI BATTLE (THE_RAKE): OFF"
    AIBattleGrad.Color = AI_BATTLE_ENABLED and GALAXY_ON_GRADIENT or GALAXY_OFF_GRADIENT
    AIBattleStroke.Color = AI_BATTLE_ENABLED and Color3.fromRGB(220, 120, 255) or Color3.fromRGB(80, 40, 120)

    if AI_BATTLE_ENABLED then
        enableContinuousNoclip()
        triggerCalamityInsideRake()

        aiBattleLoop = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            
            local _, rakePart = findTargetModel(RAKE_NAME)

            if rakePart then
                local angle = tick() * 12
                local offset = Vector3.new(math.cos(angle) * 4, 3, math.sin(angle) * 4)
                hrp.CFrame = CFrame.new(rakePart.Position + offset, rakePart.Position)
                
                executeSpamClick()
            end
        end)
    else
        if aiBattleLoop then aiBattleLoop:Disconnect() aiBattleLoop = nil end
        disableContinuousNoclip()
    end
end)

