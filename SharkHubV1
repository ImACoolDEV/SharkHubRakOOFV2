local activeMinimizedFrames = {}

local function setupMinimizeControl(frame, closeBtn)
    closeBtn.MouseButton1Click:Connect(function()
        frame.Visible = false
        table.insert(activeMinimizedFrames, frame)
        SharkCircleBtn.Visible = true
    end)
end

setupMinimizeControl(MiniGameFrame, CloseMiniGame)
