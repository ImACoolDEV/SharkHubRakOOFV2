RenameToolBtn.MouseButton1Click:Connect(function()
    local oldName = ToolOldBox.Text:lower()
    local newName = ToolNewBox.Text
    if oldName == "" or newName == "" then return end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    local count = 0

    local function check(tool)
        if tool:IsA("Tool") and string.find(tool.Name:lower(), oldName) then
            tool.Name = newName
            tool.ToolTip = newName
            count = count + 1
        end
    end

    if backpack then for _, t in ipairs(backpack:GetChildren()) do check(t) end end
    if character then for _, t in ipairs(character:GetChildren()) do check(t) end end

    RenameToolBtn.Text = count > 0 and "✅ Renamed!" or "❌ Not Found!"
    task.delay(2, function() RenameToolBtn.Text = "Rename" end)
end)

local function teleportToLocation(query)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    query = query:lower()

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if string.find(name, query) or (query == "cavea" and string.find(name, "cave1")) or (query == "caveb" and string.find(name, "cave2")) then
            local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            if targetPart then
                character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                return true
            end
        end
    end
    return false
end

