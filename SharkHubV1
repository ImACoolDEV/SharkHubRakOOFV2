-- 4. CAVE A & CAVE B TELEPORT LOGIC
--------------------------------------------------------------------------------
local function findLocationPart(targetName)
    -- Path 1: Workspace.Misc.RakoofSpawns
    local miscFolder = Workspace:FindFirstChild("Misc")
    if miscFolder then
        local rakoofSpawns = miscFolder:FindFirstChild("RakoofSpawns")
        if rakoofSpawns then
            local found = rakoofSpawns:FindFirstChild(targetName)
            if found then return found end
        end
    end

    -- Path 2: Workspace.LocationsIndicator
    local locFolder = Workspace:FindFirstChild("LocationsIndicator")
    if locFolder then
        local targetAltName = (targetName == "CaveA") and "Cave1" or (targetName == "CaveB") and "Cave2" or targetName
        local found = locFolder:FindFirstChild(targetAltName) or locFolder:FindFirstChild(targetName)
        if found then return found end
    end

    -- Fallback: Search all Workspace descendants
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == targetName then
            return obj
        end
    end

    return nil
end

local function teleportToLocation(targetName)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local targetObj = findLocationPart(targetName)
    if targetObj then
        if targetObj:IsA("BasePart") then
            character.HumanoidRootPart.CFrame = targetObj.CFrame + Vector3.new(0, 3, 0)
        elseif targetObj:IsA("Model") then
            local primary = targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart")
            if primary then
                character.HumanoidRootPart.CFrame = primary.CFrame + Vector3.new(0, 3, 0)
            end
        end
    else
        warn("Target location '" .. targetName .. "' could not be found.")
    end
end

CaveABtn.MouseButton1Click:Connect(function()
