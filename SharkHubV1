-- 6. DROPPED ITEM HIGHLIGHT & AUTO PICKUP
--------------------------------------------------------------------------------
local function markDroppedItems()
    for _, item in ipairs(Workspace:GetChildren()) do
        if (item:IsA("Tool") or item:IsA("Model") or item:IsA("BasePart")) and not Players:GetPlayerFromCharacter(item) then
            if not item:FindFirstChild("SharkItemHighlight") and (item:FindFirstChild("Handle") or item:IsA("BasePart")) then
                local highlight = Instance.new("Highlight")
                highlight.Name = "SharkItemHighlight"
                highlight.FillColor = Color3.fromRGB(0, 210, 255)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.OutlineTransparency = 0
                highlight.Parent = item
            end
        end
    end
end

local function teleportToDroppedItems()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:FindFirstChild("SharkItemHighlight") then
            local targetCFrame = nil
            if obj:IsA("BasePart") then
                targetCFrame = obj.CFrame
            elseif obj:FindFirstChild("Handle") then
                targetCFrame = obj.Handle.CFrame
            elseif obj.PrimaryPart then
                targetCFrame = obj.PrimaryPart.CFrame
            end

            if targetCFrame then
                character.HumanoidRootPart.CFrame = targetCFrame
                task.wait(0.1)
            end
        end
    end
end

